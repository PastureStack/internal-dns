#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
version="${VERSION:-dev}"
platforms=(linux/amd64 windows/amd64)

for platform in "${platforms[@]}"; do
  os="${platform%/*}"
  arch="${platform#*/}"
  output="bin/$os/$arch/internal-dns"
  if [[ "$os" == "windows" ]]; then
    output+=".exe"
  fi
  mkdir -p "$(dirname "$output")"
  printf 'Building %s...\n' "$platform"
  GOOS="$os" GOARCH="$arch" CGO_ENABLED=0 \
    go build -buildvcs=false -trimpath -ldflags "-X main.VERSION=$version -s -w" -o "$output" .
done
