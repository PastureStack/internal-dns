#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
tag="${TAG:-dev}"
repository="${REPO:-ghcr.io/pasturestack}"
image="${repository}/internal-dns:${tag}"

docker build \
  --provenance=false \
  --network "${DOCKER_BUILD_NETWORK:-default}" \
  --build-arg UBUNTU_MIRROR="${UBUNTU_MIRROR:-http://archive.ubuntu.com/ubuntu}" \
  --build-arg IMAGE_VERSION="$tag" \
  -t "$image" \
  -f package/linux/amd64/Dockerfile .

mkdir -p dist
printf '%s\n' "$image" > dist/images
printf 'Built %s\n' "$image"
